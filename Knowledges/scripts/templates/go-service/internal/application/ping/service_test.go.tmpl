package ping_test

import (
	"context"
	"errors"
	"fmt"
	"testing"
	"time"

	appping "__MODULE__/internal/application/ping"
	domainping "__MODULE__/internal/domain/ping"
)

// Regra do guia (T2): portas são substituídas por fakes locais e pequenos.
// Nada de mock framework, nada de banco para testar regra de negócio.

type fakeRepository struct {
	saved []domainping.Ping
	err   error
}

func (f *fakeRepository) Save(_ context.Context, p domainping.Ping) error {
	if f.err != nil {
		return f.err
	}
	f.saved = append(f.saved, p)
	return nil
}

func (f *fakeRepository) Last(_ context.Context) (domainping.Ping, bool, error) {
	if len(f.saved) == 0 {
		return domainping.Ping{}, false, f.err
	}
	return f.saved[len(f.saved)-1], true, nil
}

type fixedClock struct{ now time.Time }

func (c fixedClock) Now() time.Time { return c.now }

type sequenceIDs struct{ next int }

func (s *sequenceIDs) New() string {
	s.next++
	return fmt.Sprintf("id-%d", s.next)
}

func TestServiceExecute(t *testing.T) {
	t.Parallel()

	createErr := errors.New("database unavailable")
	now := time.Date(2026, 10, 30, 12, 0, 0, 0, time.UTC)

	tests := []struct {
		name        string
		message     string
		repoErr     error
		wantErr     error
		wantSaved   int
		wantMessage string
	}{
		{
			name:        "persists a valid ping",
			message:     "  hello  ",
			wantSaved:   1,
			wantMessage: "hello",
		},
		{
			name:      "rejects empty message",
			message:   "   ",
			wantErr:   domainping.ErrEmptyMessage,
			wantSaved: 0,
		},
		{
			name:      "propagates repository failure",
			message:   "hello",
			repoErr:   createErr,
			wantErr:   createErr,
			wantSaved: 0,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			t.Parallel()

			repo := &fakeRepository{err: tt.repoErr}
			svc := appping.NewService(repo, fixedClock{now: now}, &sequenceIDs{})

			out, err := svc.Execute(context.Background(), appping.Input{Message: tt.message})
			if !errors.Is(err, tt.wantErr) {
				t.Fatalf("Execute() error = %v, want %v", err, tt.wantErr)
			}
			if len(repo.saved) != tt.wantSaved {
				t.Fatalf("saved = %d, want %d", len(repo.saved), tt.wantSaved)
			}
			if tt.wantErr != nil {
				return
			}
			if out.Message != tt.wantMessage {
				t.Errorf("Message = %q, want %q", out.Message, tt.wantMessage)
			}
			if !out.CreatedAt.Equal(now) {
				t.Errorf("CreatedAt = %v, want %v", out.CreatedAt, now)
			}
		})
	}
}
