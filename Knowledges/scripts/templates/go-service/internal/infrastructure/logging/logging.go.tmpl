// Package logging builds the structured logger.
//
// Regra do guia (F3): log é JSON estruturado (log/slog), com nível validado na
// configuração. Nunca fmt.Println para diagnóstico operacional.
package logging

import (
	"log/slog"
	"os"
)

// New builds a JSON logger for the given level.
func New(level string) *slog.Logger {
	options := &slog.HandlerOptions{Level: parseLevel(level)}
	return slog.New(slog.NewJSONHandler(os.Stdout, options))
}

func parseLevel(level string) slog.Level {
	switch level {
	case "debug":
		return slog.LevelDebug
	case "warn":
		return slog.LevelWarn
	case "error":
		return slog.LevelError
	default:
		return slog.LevelInfo
	}
}
