// Package app is the composition root and lifecycle owner.
//
// Regra do guia (F4): o wiring acontece aqui, uma vez, de forma explícita.
// Sem framework de DI, sem init(), sem variável global mutável.
package app

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"time"

	httpadapter "__MODULE__/internal/adapters/inbound/http"
	"__MODULE__/internal/infrastructure/config"
)

// App owns the process resources.
type App struct {
	cfg     config.Config
	log     *slog.Logger
	server  *http.Server
	cleanup func()
}

// New wires dependencies, features and the HTTP server.
func New(ctx context.Context, cfg config.Config, log *slog.Logger) (*App, error) {
	deps, cleanup, err := buildDependencies(ctx, cfg, log)
	if err != nil {
		return nil, err
	}

	api := http.NewServeMux()
	if err := registerFeatures(api, deps); err != nil {
		cleanup()
		return nil, fmt.Errorf("register features: %w", err)
	}

	return &App{
		cfg:     cfg,
		log:     log,
		cleanup: cleanup,
		server: &http.Server{
			Addr:              cfg.HTTPAddr,
			Handler:           httpadapter.Mount(api, deps.Ready()),
			ReadHeaderTimeout: 5 * time.Second,
			ReadTimeout:       30 * time.Second,
			WriteTimeout:      30 * time.Second,
			IdleTimeout:       120 * time.Second,
		},
	}, nil
}

// Run serves until the context is cancelled or the server fails.
//
// Regra do guia (F5): shutdown ordenado — parar de aceitar conexões, drenar
// requisições e só então fechar recursos. Loops de background seguem o mesmo
// contrato, cada um com ctx e métrica próprios.
func (a *App) Run(ctx context.Context) error {
	errCh := make(chan error, 1)

	go func() {
		a.log.Info("http server listening", "addr", a.cfg.HTTPAddr)
		errCh <- a.server.ListenAndServe()
	}()

	select {
	case <-ctx.Done():
		a.log.Info("shutdown requested")
	case err := <-errCh:
		if !errors.Is(err, http.ErrServerClosed) {
			return fmt.Errorf("http server: %w", err)
		}
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	if err := a.server.Shutdown(shutdownCtx); err != nil {
		return fmt.Errorf("shutdown: %w", err)
	}
	return nil
}

// Close releases resources that are not owned by the HTTP server.
func (a *App) Close() error {
	a.cleanup()
	return nil
}
