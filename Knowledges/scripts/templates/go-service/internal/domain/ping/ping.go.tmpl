// Package ping contains the domain of the scaffold example.
//
// Regra do guia (D1): o domínio não importa application, ports, adapters ou
// infrastructure. Também não conhece HTTP, JSON, SQL, pgx ou SDKs externos.
package ping

import (
	"strings"
	"time"
)

// ValidationError describes a violated invariant in a transport-agnostic way.
//
// Regra do guia (D3/I4): o erro carrega campo e mensagem estável. A borda HTTP
// reconhece o formato pela interface FieldName/FieldMessage, sem importar o
// pacote de domínio.
type ValidationError struct {
	Field   string
	Message string
}

func (e ValidationError) Error() string { return e.Message }

// FieldName returns the offending field.
func (e ValidationError) FieldName() string { return e.Field }

// FieldMessage returns the public message for the client.
func (e ValidationError) FieldMessage() string { return e.Message }

var (
	// ErrEmptyID is returned when an aggregate is built without an identity.
	ErrEmptyID = ValidationError{Field: "id", Message: "id is required"}
	// ErrEmptyMessage is returned when the message has no visible content.
	ErrEmptyMessage = ValidationError{Field: "message", Message: "message is required"}
	// ErrMessageTooLong is returned when the message exceeds the domain limit.
	ErrMessageTooLong = ValidationError{Field: "message", Message: "message exceeds 280 characters"}
)

const maxMessageLength = 280

// Ping is the aggregate root of the example.
//
// Regra do guia (D2): campos são privados; a única forma de obter um valor
// válido é pelo construtor, que aplica as invariantes.
type Ping struct {
	id        string
	message   string
	createdAt time.Time
}

// New validates the invariants and builds a valid Ping.
func New(id, message string, createdAt time.Time) (Ping, error) {
	if id == "" {
		return Ping{}, ErrEmptyID
	}

	message = strings.TrimSpace(message)
	switch {
	case message == "":
		return Ping{}, ErrEmptyMessage
	case len([]rune(message)) > maxMessageLength:
		return Ping{}, ErrMessageTooLong
	}

	return Ping{id: id, message: message, createdAt: createdAt.UTC()}, nil
}

// ID returns the aggregate identity.
func (p Ping) ID() string { return p.id }

// Message returns the normalized message.
func (p Ping) Message() string { return p.message }

// CreatedAt returns the creation instant in UTC.
func (p Ping) CreatedAt() time.Time { return p.createdAt }
