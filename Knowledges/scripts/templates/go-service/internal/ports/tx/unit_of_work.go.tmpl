// Package tx declares the transaction boundary port.
//
// Regra do guia (A5): um caso de uso que escreve mais de um agregado abre uma
// transação via UnitOfWork. O adapter decide como (pgx, database/sql).
package tx

import "context"

// UnitOfWork runs fn inside a transaction.
type UnitOfWork interface {
	WithinTransaction(ctx context.Context, fn func(ctx context.Context) error) error
}
