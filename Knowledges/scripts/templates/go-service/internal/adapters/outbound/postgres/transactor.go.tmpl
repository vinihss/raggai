package postgres

import (
	"context"
	"fmt"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/jackc/pgx/v5/pgxpool"

	"__MODULE__/internal/ports/tx"
)

// txKey keeps the transaction private to this package.
type txKey struct{}

// DBTX is the subset shared by *pgxpool.Pool and pgx.Tx.
type DBTX interface {
	Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error)
	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
}

// querier returns the transaction bound to ctx, or the pool when there is none.
//
// Regra do guia (A5/O5): o caso de uso não abre transação e não conhece pgx; o
// repositório apenas participa da transação já aberta, via context.
func querier(ctx context.Context, pool *pgxpool.Pool) DBTX {
	if transaction, ok := ctx.Value(txKey{}).(pgx.Tx); ok {
		return transaction
	}
	return pool
}

// UnitOfWork runs use case functions inside a database transaction.
type UnitOfWork struct {
	pool *pgxpool.Pool
}

var _ tx.UnitOfWork = (*UnitOfWork)(nil)

// NewUnitOfWork builds the transactor over the shared pool.
func NewUnitOfWork(pool *pgxpool.Pool) *UnitOfWork {
	return &UnitOfWork{pool: pool}
}

// WithinTransaction commits on success and rolls back on error or panic.
func (u *UnitOfWork) WithinTransaction(ctx context.Context, fn func(ctx context.Context) error) error {
	transaction, err := u.pool.Begin(ctx)
	if err != nil {
		return fmt.Errorf("begin transaction: %w", err)
	}

	defer func() {
		// Rollback after commit is a no-op in pgx.
		_ = transaction.Rollback(ctx)
	}()

	if err := fn(context.WithValue(ctx, txKey{}, transaction)); err != nil {
		return err
	}

	if err := transaction.Commit(ctx); err != nil {
		return fmt.Errorf("commit transaction: %w", err)
	}
	return nil
}
