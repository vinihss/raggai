// Package postgres implements outbound ports with pgx.
//
// Regra do guia (O3/O4): SQL vive aqui, em constantes legíveis, sempre com ctx.
// O erro do driver é traduzido para o erro da porta antes de sair do adapter.
package postgres

import (
	"context"
	"errors"
	"fmt"
	"time"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"

	domainping "__MODULE__/internal/domain/ping"
	"__MODULE__/internal/ports/repositories"
)

const (
	savePingQuery = `INSERT INTO pings (id, message, created_at) VALUES ($1, $2, $3)`
	lastPingQuery = `SELECT id, message, created_at FROM pings ORDER BY created_at DESC LIMIT 1`
)

// PingRepository stores pings in Postgres.
type PingRepository struct {
	pool *pgxpool.Pool
}

// Regra do guia (O6): conformidade verificada em tempo de compilação.
var _ repositories.PingRepository = (*PingRepository)(nil)

// NewPingRepository builds a repository over the shared pool.
func NewPingRepository(pool *pgxpool.Pool) *PingRepository {
	return &PingRepository{pool: pool}
}

// Save inserts the aggregate.
func (r *PingRepository) Save(ctx context.Context, p domainping.Ping) error {
	if _, err := querier(ctx, r.pool).Exec(ctx, savePingQuery, p.ID(), p.Message(), p.CreatedAt()); err != nil {
		return fmt.Errorf("insert ping: %w", err)
	}
	return nil
}

// Last returns the most recent aggregate, if any.
func (r *PingRepository) Last(ctx context.Context) (domainping.Ping, bool, error) {
	var (
		id        string
		message   string
		createdAt time.Time
	)

	err := querier(ctx, r.pool).QueryRow(ctx, lastPingQuery).Scan(&id, &message, &createdAt)
	switch {
	case errors.Is(err, pgx.ErrNoRows):
		return domainping.Ping{}, false, nil
	case err != nil:
		return domainping.Ping{}, false, fmt.Errorf("select last ping: %w", err)
	}

	aggregate, err := domainping.New(id, message, createdAt)
	if err != nil {
		return domainping.Ping{}, false, fmt.Errorf("rebuild ping: %w", err)
	}
	return aggregate, true, nil
}
