// Package memory provides in-memory outbound adapters for the scaffold.
//
// Regra do guia (O1): o adapter implementa a porta e traduz o mundo externo.
// Trocar memória por Postgres não muda uma linha de application/domain.
package memory

import (
	"context"
	"sync"

	domainping "__MODULE__/internal/domain/ping"
	"__MODULE__/internal/ports/repositories"
)

// PingRepository keeps the last Ping in memory. Safe for concurrent use.
type PingRepository struct {
	mu   sync.RWMutex
	last domainping.Ping
	set  bool
}

var _ repositories.PingRepository = (*PingRepository)(nil)

// NewPingRepository builds an empty repository.
func NewPingRepository() *PingRepository {
	return &PingRepository{}
}

// Save stores the aggregate.
func (r *PingRepository) Save(_ context.Context, p domainping.Ping) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	r.last = p
	r.set = true
	return nil
}

// Last returns the most recently saved aggregate.
func (r *PingRepository) Last(_ context.Context) (domainping.Ping, bool, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	return r.last, r.set, nil
}
