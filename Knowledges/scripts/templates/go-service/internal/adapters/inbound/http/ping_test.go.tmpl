package http_test

import (
	"bytes"
	"context"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"testing"
	"time"

	httpadapter "__MODULE__/internal/adapters/inbound/http"
	appping "__MODULE__/internal/application/ping"
	domainping "__MODULE__/internal/domain/ping"
)

// Regra do guia (T3): adapter HTTP é testado com httptest e um fake do caso de
// uso; não sobe servidor nem banco.
type fakePinger struct {
	out appping.Output
	err error
}

func (f fakePinger) Execute(_ context.Context, _ appping.Input) (appping.Output, error) {
	return f.out, f.err
}

func TestCreatePing(t *testing.T) {
	t.Parallel()

	createdAt := time.Date(2026, 10, 30, 12, 0, 0, 0, time.UTC)

	tests := []struct {
		name       string
		body       string
		handler    httpadapter.Pinger
		wantStatus int
		wantCode   string
	}{
		{
			name: "creates ping",
			body: `{"message":"hello"}`,
			handler: fakePinger{out: appping.Output{
				ID: "id-1", Message: "hello", CreatedAt: createdAt,
			}},
			wantStatus: http.StatusCreated,
		},
		{
			name:       "rejects malformed body",
			body:       `{"message":`,
			handler:    fakePinger{},
			wantStatus: http.StatusBadRequest,
			wantCode:   "validation_error",
		},
		{
			name:       "maps domain error",
			body:       `{"message":""}`,
			handler:    fakePinger{err: domainping.ErrEmptyMessage},
			wantStatus: http.StatusUnprocessableEntity,
			wantCode:   "validation_error",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			t.Parallel()

			api := http.NewServeMux()
			httpadapter.RegisterPing(api, tt.handler)
			router := httpadapter.Mount(api, func(context.Context) error { return nil })

			req := httptest.NewRequest(http.MethodPost, "/api/v1/ping", bytes.NewBufferString(tt.body))
			rec := httptest.NewRecorder()
			router.ServeHTTP(rec, req)

			if rec.Code != tt.wantStatus {
				t.Fatalf("status = %d, want %d (body=%s)", rec.Code, tt.wantStatus, rec.Body.String())
			}
			if tt.wantCode == "" {
				return
			}

			var got map[string]string
			if err := json.Unmarshal(rec.Body.Bytes(), &got); err != nil {
				t.Fatalf("decode response: %v", err)
			}
			if got["code"] != tt.wantCode {
				t.Errorf("code = %q, want %q", got["code"], tt.wantCode)
			}
		})
	}
}
