// Package http mounts the inbound HTTP adapter.
//
// Regra do guia (I3): o prefixo de versão é registrado uma única vez, aqui.
// Features registram apenas seus sufixos no ServeMux recebido.
package http

import (
	"net/http"

	"__MODULE__/internal/adapters/inbound/http/middleware"
)

// Mount wraps the versioned API mux with the public endpoints and middleware.
func Mount(api *http.ServeMux, ready ReadyFunc) http.Handler {
	mux := http.NewServeMux()
	mux.Handle("/api/v1/", http.StripPrefix("/api/v1", api))
	mux.HandleFunc("GET /healthz", healthz)
	mux.HandleFunc("GET /readyz", readyz(ready))

	return middleware.Chain(mux,
		middleware.RequestID,
		middleware.Recover,
		middleware.AccessLog,
	)
}
