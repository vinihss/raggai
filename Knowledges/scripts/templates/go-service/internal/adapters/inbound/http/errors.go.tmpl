package http

import (
	"encoding/json"
	"errors"
	"fmt"
	"log/slog"
	"net/http"

	"__MODULE__/internal/adapters/inbound/http/dto"
	"__MODULE__/internal/ports/repositories"
)

// errInvalidBody marks transport-level decoding failures.
var errInvalidBody = errors.New("invalid request body")

// fieldError is implemented by domain validation errors. Keeping it as an
// interface lets every feature map its own errors without editing this file.
//
// Regra do guia (I4): mapeamento erro → status/código vive em um único lugar.
type fieldError interface {
	FieldName() string
	FieldMessage() string
}

// writeJSON writes a JSON response with the correct content type.
func writeJSON(w http.ResponseWriter, status int, body any) {
	w.Header().Set("Content-Type", "application/json; charset=utf-8")
	w.WriteHeader(status)

	if body == nil {
		return
	}
	_ = json.NewEncoder(w).Encode(body)
}

// writeError translates a domain/application/port error into a stable response.
func writeError(w http.ResponseWriter, r *http.Request, err error) {
	status := http.StatusInternalServerError
	code := "internal"
	message := "internal error"

	var invalidField fieldError

	switch {
	case errors.Is(err, errInvalidBody):
		status, code, message = http.StatusBadRequest, "validation_error", "invalid request body"

	case errors.As(err, &invalidField):
		status, code, message = http.StatusUnprocessableEntity, "validation_error", invalidField.FieldMessage()

	case errors.Is(err, repositories.ErrNotFound):
		status, code, message = http.StatusNotFound, "not_found", "resource not found"

	case errors.Is(err, repositories.ErrConflict):
		status, code, message = http.StatusConflict, "conflict", "resource conflict"
	}

	if status >= http.StatusInternalServerError {
		slog.ErrorContext(r.Context(), "request failed", "error", err, "path", r.URL.Path)
	}

	writeJSON(w, status, dto.ErrorResponse{Code: code, Message: message})
}

// decodeJSON decodes a request body with a size limit and strict fields.
func decodeJSON(w http.ResponseWriter, r *http.Request, target any, maxBytes int64) error {
	decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, maxBytes))
	decoder.DisallowUnknownFields()
	if err := decoder.Decode(target); err != nil {
		return fmt.Errorf("%w: %v", errInvalidBody, err)
	}
	return nil
}
