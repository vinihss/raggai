package http

import (
	"context"
	"net/http"
	"time"

	"__MODULE__/internal/adapters/inbound/http/dto"
	appping "__MODULE__/internal/application/ping"
)

const maxBodyBytes = 64 << 10

// Pinger is the inbound port consumed by this adapter.
//
// Regra do guia (P3): a interface é declarada por quem consome.
type Pinger interface {
	Execute(ctx context.Context, in appping.Input) (appping.Output, error)
}

// RegisterPing mounts the ping feature on the versioned API mux.
func RegisterPing(api *http.ServeMux, ping Pinger) {
	api.HandleFunc("POST /ping", newPingHandler(ping).create)
}

type pingHandler struct {
	ping Pinger
}

func newPingHandler(p Pinger) *pingHandler {
	return &pingHandler{ping: p}
}

// create handles POST /api/v1/ping.
func (h *pingHandler) create(w http.ResponseWriter, r *http.Request) {
	var req dto.CreatePingRequest
	if err := decodeJSON(w, r, &req, maxBodyBytes); err != nil {
		writeError(w, r, err)
		return
	}

	out, err := h.ping.Execute(r.Context(), appping.Input{Message: req.Message})
	if err != nil {
		writeError(w, r, err)
		return
	}

	writeJSON(w, http.StatusCreated, dto.PingResponse{
		ID:        out.ID,
		Message:   out.Message,
		CreatedAt: out.CreatedAt.Format(time.RFC3339Nano),
	})
}
