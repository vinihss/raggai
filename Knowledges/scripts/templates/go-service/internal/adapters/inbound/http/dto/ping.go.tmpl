// Package dto holds the HTTP wire contracts.
//
// Regra do guia (I2): DTO de transporte é separado da entidade de domínio.
// Tags JSON vivem aqui, nunca em internal/domain.
package dto

// CreatePingRequest is the body of POST /api/v1/ping.
type CreatePingRequest struct {
	Message string `json:"message"`
}

// PingResponse is the representation returned to clients.
type PingResponse struct {
	ID        string `json:"id"`
	Message   string `json:"message"`
	CreatedAt string `json:"created_at"`
}
