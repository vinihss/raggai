{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noConsole": { "level": "off", "options": { "allow": ["log", "error"] } },
			"noExplicitAny": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineWidth": 100
	},

	"javascript": {
		"formatter": { "quoteStyle": "double", "semicolons": "always" }
	}
}
