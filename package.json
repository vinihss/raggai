{
  "name": "opencode-hybrid-rag",
  "version": "1.1.0",
  "description": "Memória híbrida local vetor + grafo para agentes OpenCode",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "raggai": "./bin/raggai"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "rag-memory.md",
    "README.md",
    "AGENTS.md",
    "install.ts",
    "install-opencode.ts"
  ],
  "dependencies": {
    "@lancedb/lancedb": "^0.11.0",
    "@opencode/plugin": "^2.2.7",
    "@xenova/transformers": "^2.17.2",
    "express": "^5.3.0",
    "graphology": "^0.25.4",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1"
  },
  "trustedDependencies": [
    "protobufjs"
  ],
  "overrides": {
    "sharp": "^0.35.5"
  },
  "scripts": {
    "prepack": "bun run build",
    "build": "bun build ./src/index.ts --outdir ./dist --target node --external @opencode/plugin --external @xenova/transformers --external sharp --external onnxruntime-node --external @lancedb/lancedb && bun build ./src/cli/index.ts --outdir ./dist/cli --target bun",
    "build:plugin": "bun build ./src/index.ts --outdir ./dist --target node --external @opencode/plugin --external @xenova/transformers --external sharp --external onnxruntime-node --external @lancedb/lancedb",
    "build:cli": "bun build ./src/cli/index.ts --outdir ./dist/cli --target bun",
    "lint": "biome check ./src --config-path=./biome.json || true",
    "format": "biome format --write ./src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/glob": "^8.1.0",
    "glob": "^14.0.3"
  }
}